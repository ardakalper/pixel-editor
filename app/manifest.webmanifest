{
  "name": "Pixel Editor",
  "short_name": "Pixels",
  "description": "A browser pixel-art editor in the spirit of Aseprite: 20 tools, selections, layers, frames and tags, palettes, effects, sprite sheet and GIF export. Works offline.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0d0a1f",
  "theme_color": "#0d0a1f",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
